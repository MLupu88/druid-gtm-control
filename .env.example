# ─── DRUID GTM Mission Control — environment variables ─────────────────────
# Copy this file to .env and fill in real values.
# The browser MUST NOT see any of these — all secrets are server-side only.

APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=https://gtm.aiexperiments.eu

# ── Operator identity (optional) ────────────────────────────────────────────
# JSON object mapping a login code to a named operator. When set, this
# replaces APP_PASSWORD for login and the server stamps approved_by /
# approved_by_email / operator_role onto every n8n action from the matched
# operator record instead of trusting anything the client sends.
# Example:
# OPERATORS={"some-code":{"name":"Mihail Lupu","email":"mihail.lupu@druidai.com","role":"operator"}}
OPERATORS=

# ── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1GDZXumXH_usoxhv4vCjuhSeQMOp0m2aQponcAy3jTgI

# ── n8n webhook endpoints ──────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.aiexperiments.eu
N8N_WEBHOOK_SECRET=

# ── External analytics ────────────────────────────────────────────────────
# Looker Studio / Google Data Studio URL. Safe to expose to the browser.
VITE_MARKETPLACE_ANALYTICS_URL=

# ── PostgreSQL operational ledger ───────────────────────────────────────────
# Durable, append-friendly store for accounts/signals/scores/decisions/actions.
# Google Sheets remains the system of record for existing routes; this ledger
# does not replace it in this unit. gtm-postgres is only reachable on the
# internal n8n_network (no host port is published) — DATABASE_URL must use
# the service hostname, not localhost, when running via docker compose.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://__POSTGRES_USER__:__POSTGRES_PASSWORD__@gtm-postgres:5432/__POSTGRES_DB__

# ── App ────────────────────────────────────────────────────────────────────
PORT=5000




