# ─── DRUID GTM Mission Control — environment variables ─────────────────────
# Copy this file to .env and fill in real values.
# The browser MUST NOT see any of these — all secrets are server-side only.

APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=https://gtm.aiexperiments.eu

# ── Operator identity (optional) ────────────────────────────────────────────
# JSON object mapping a login code to a named operator. When set, this
# replaces APP_PASSWORD for login and the server stamps approved_by /
# approved_by_email / operator_role onto every n8n action from the matched
# operator record instead of trusting anything the client sends.
# Example:
# OPERATORS={"some-code":{"name":"Mihail Lupu","email":"mihail.lupu@druidai.com","role":"operator"}}
OPERATORS=

# ── PostgreSQL (@workspace/db — Package 2 ICP profile/evaluation schema) ───
# Required by lib/db (drizzle.config.ts, src/index.ts, src/migrate.ts).
# See lib/db/README.md for local setup. The gtm-db Compose service provisions
# Postgres for Docker deployments (see docker-compose.yml); for direct
# non-Compose development, point this at your own local Postgres instance.
DATABASE_URL=

# Used by the gtm-db Compose service and to build DATABASE_URL for
# gtm-control/gtm-control-migrate at the Compose level (see
# docker-compose.yml). DATABASE_URL above stays independently useful for
# direct non-Compose development and migration commands.
GTM_POSTGRES_USER=
GTM_POSTGRES_PASSWORD=
GTM_POSTGRES_DB=

# ── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1GDZXumXH_usoxhv4vCjuhSeQMOp0m2aQponcAy3jTgI

# ── n8n webhook endpoints ──────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.aiexperiments.eu
N8N_WEBHOOK_SECRET=

# ── Client Radar research integration ──────────────────────────────────────
# Server-side only. Used by the GTM API to submit and retrieve research runs.
CLIENT_RADAR_BASE_URL=https://client-radar.aiexperiments.eu
CLIENT_RADAR_API_TOKEN=

# ── HubSpot company identity synchronization ────────────────────────────────────────
# Server-side Bearer access token used only for read-only HubSpot company API calls.
HUBSPOT_ACCESS_TOKEN=

# ── Signal ingestion ───────────────────────────────────────────────────────
# Shared secret for POST /api/internal/signals.
# The endpoint fails closed with HTTP 503 when this is unset.
GTM_SIGNAL_INGESTION_SECRET=

# ── External analytics ────────────────────────────────────────────────────
# Looker Studio / Google Data Studio URL. Safe to expose to the browser.
VITE_MARKETPLACE_ANALYTICS_URL=

# ── App ────────────────────────────────────────────────────────────────────
PORT=5000



